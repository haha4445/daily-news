      "kind": "zhihu-daily",
      "name": "知乎日报",
      "category": "社区",
      "url": "https://news-at.zhihu.com/api/4/news/latest",
      "max": 3
    },
    {
      "id": "baidu-game",
      "enabled": true,
      "kind": "baidu",
      "name": "百度热搜·游戏",
      "category": "娱乐",
      "url": "https://top.baidu.com/board?tab=game",
      "max": 3
    },
    {
      "id": "baidu-movie",
      "enabled": false,
      "kind": "baidu",
      "name": "百度热搜·电影",
      "category": "娱乐",
      "url": "https://top.baidu.com/board?tab=movie",
      "max": 3
    },
    {
      "id": "bilibili-rank",
      "enabled": false,
      "kind": "bilibili",
      "name": "B站全站排行",
      "category": "社区",
      "url": "https://api.bilibili.com/x/web-interface/ranking/v2?rid=0&type=all",
